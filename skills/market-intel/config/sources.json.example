      "serves": ["intel", "lead"],
      "tier": "T2",
      "owner_entity": null,
      "tags": ["媒体", "AI", "行业"],
      "windowed": true,
      "stale_after_hours": 168,
      "notes": "2026-10-23 实测可用。"
    },
    {
      "id": "geekpark-rss",
