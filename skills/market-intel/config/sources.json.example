    {
      "id": "techcrunch-feed",
      "name": "TechCrunch",
      "kind": "rss",
      "url": "https://techcrunch.com/feed/",
      "enabled": true,
      "serves": ["intel", "lead"],
      "tier": "T2",
      "owner_entity": null,
      "tags": ["媒体", "融资事件", "海外"],
      "windowed": true,
      "stale_after_hours": 72,
      "notes": "2026-10-23 实测可用。更新频率高（小时级），停更阈值收紧到 3 天。融资事件报道密度高，是线索发现的重要英文源。"
    },
    {
      "id": "example-36kr-rsshub",
      "name": "36氪快讯（RSSHub 自部署）",
      "kind": "mp_account",
      "url": "http://127.0.0.1:1200/36kr/newsflights",
      "enabled": false,
      "serves": ["intel", "lead"],
      "tier": "T2",
      "owner_entity": null,
      "tags": ["媒体", "快讯", "融资事件"],
      "windowed": true,
      "stale_after_hours": 72,
      "notes": "36氪原生 RSS 已失效（2026-10-23 实测返回 HTML）。此条为自部署 RSSHub 示例：公共实例 rsshub.app 被 Cloudflare 拦截不可用，须自建实例后把 url 换成实际地址并把 enabled 改为 true。"
    },
    {
      "id": "example-itjuzi-mp",
      "name": "IT桔子公众号（RSSHub 自部署）",
      "kind": "mp_account",
      "url": "http://127.0.0.1:1200/wechat/uread/itjuzi",
      "enabled": false,
      "serves": ["lead"],
      "tier": "T1_5",
      "owner_entity": null,
      "tags": ["融资事件", "创投数据库"],
      "windowed": true,
      "stale_after_hours": 336,
      "notes": "微信公众号采集依赖搜狗通道，时灵时不灵：必须低频轮询（建议 >=120 分钟），失败会显式报错而非静默空结果。作为线索发现的补充源，不作为唯一信源。"
    },
    {
      "id": "example-company-careers",
      "name": "示例：某公司官网招聘页（页面监测）",
      "kind": "web_page",
      "url": "https://example-company.com/about/careers",
      "enabled": false,
      "serves": ["lead"],
      "tier": "T1",
      "owner_entity": "example-company",
      "tags": ["招聘信号"],
      "windowed": false,
      "stale_after_hours": null,
      "config": {
        "keywords": ["算法工程师", "大模型", "后端开发", "增长运营"]
      },
      "notes": "官网招聘页差分：config.keywords 里列出的关键词在页面出现/消失时各产出一条变更（岗位新增/下线是最强的业务扩张信号）。owner_entity 指向词表里的公司，档案直接归到它名下。示例域名为占位，使用时替换为真实目标公司招聘页。"
    }
  ]
}
