{
  "_comment": "market-intel 公共数据源登记册。首次运行会复制到工作区（默认 ~/.market-intel/sources.json），此后以工作区那份为准。两个需求（intel=行业情报 / lead=线索发现）共用这份清单，按 serves 字段按需选用；采集参数统一，不按需求分裂。字段语义见 references/sources-guide.md。",
  "version": 1,
  "settings": {
    "stale_after_hours": 168,
    "_comment_stale": "全局停更阈值（小时）。单源可用同名字段覆盖；写 null 表示该源不检查停更。",
    "request_timeout_seconds": 30,
    "request_retries": 1,
    "collect_concurrency": 6,
    "host_concurrency": 2,
    "collect_wall_clock_seconds": 300,
    "_comment_concurrency": "并发采集约束沿用 change-watch：collect_concurrency=全局线程数，host_concurrency=同域名并发上限，collect_wall_clock_seconds=整轮壁钟上限。排查时把 collect_concurrency 设为 1 退回串行。"
  },
  "sources": [
    {
      "id": "qbitai-feed",
      "name": "量子位",
      "kind": "rss",
      "url": "https://www.qbitai.com/feed",
      "enabled": true,
      "serves": ["intel", "lead"],
      "tier": "T2",
      "owner_entity": null,
      "tags": ["媒体", "AI", "融资事件"],
      "windowed": true,
      "stale_after_hours": 168,
      "notes": "2026-10-23 实测可用（原生 WordPress RSS）。AI 行业动态与融资报道主力中文源。"
    },
    {
